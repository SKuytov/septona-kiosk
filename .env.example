# Copy to .env and edit before first start.

# Port the management platform is published on.
HTTP_PORT=8080

# Database credentials. Changing these after first start requires recreating the
# db volume, so pick them now.
POSTGRES_USER=septona
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=septona_kiosk

# Signs admin session tokens. Any long random string; changing it logs everyone out.
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# The first administrator, created only when the user table is empty.
# Change the password immediately after the first login.
ADMIN_EMAIL=admin@septona.local
ADMIN_PASSWORD=septona-admin

# ---------------------------------------------------------------- Remote access
# Filled in by deploy/setup-tunnel.sh. Leave both empty for a LAN-only installation.
#
# The public address of the management platform. Setting it turns on HSTS and makes the
# server refuse to start while a weak JWT_SECRET or the factory admin password is in use.
PUBLIC_ORIGIN=
# Connector token from Cloudflare Zero Trust > Networks > Tunnels.
TUNNEL_TOKEN=
# Extra browser origins allowed to call the API. Normally empty — the panel and the
# kiosk are served by this same process, and the Android app is allowed by default.
ALLOWED_ORIGINS=
